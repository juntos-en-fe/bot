# Required: Discord bot token from the Developer Portal.
DISCORD_TOKEN=replace-with-your-bot-token

# Required: Discord application ID. Usually the same numeric ID as the bot user.
DISCORD_APPLICATION_ID=replace-with-your-application-id

# Optional: a development server ID. Commands register immediately in this guild.
# Leave blank to register commands globally (which can take up to an hour to propagate).
DISCORD_GUILD_ID=

# Optional: relative or absolute SQLite database location.
DATABASE_PATH=data/bot.db

# Optional: debug, info, warn, or error.
LOG_LEVEL=info
